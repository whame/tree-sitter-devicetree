{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "devicetree",
      "camelcase": "Devicetree",
      "title": "Devicetree",
      "scope": "source.devicetree",
      "file-types": [
        "dtsi",
        "dts"
      ],
      "injection-regex": "^devicetree$",
      "class-name": "TreeSitterDevicetree"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0",
    "description": "Devicetree grammar for tree-sitter",
    "authors": [
      {
        "name": "Waqar Hameed",
        "email": "whame@whame.dev",
        "url": "https://whame.dev"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/whame/tree-sitter-devicetree",
      "funding": "https://github.com/sponsors/whame"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}